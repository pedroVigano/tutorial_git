# Copie para .env (não versionado) para rodar localmente contra o Notion real: npm run dev:live
# Em produção (Cloud Run) estas variáveis vêm do deploy e do Secret Manager — ver docs/deploy-gcp.md.

# Token da integração interna do Notion criada só para o dashboard (secret_...)
NOTION_TOKEN=

# live = Notion real · fixture = demonstração com o Notion falso (foto de dados do mock), sem token
NOTION_MODE=live

# dev = usuário fixo, sem login (só local) · iap = Cloud Run com Identity-Aware Proxy
AUTH_MODE=dev
DEV_USER_EMAIL=seu.nome@bsvrobotics.com.br

# Quem grava no Notion (e-mails separados por vírgula). Em dev, vazio = o usuário local grava.
EDITOR_EMAILS=

# Domínio aceito no login (contas de fora são recusadas)
ALLOWED_DOMAIN=bsvrobotics.com.br

# Cache do snapshot do Notion, em segundos
CACHE_TTL_SECONDS=120

# Limite de requisições ao Notion (a API aceita ~3 por segundo por integração)
NOTION_RATE_PER_SEC=3

# Só se a audiência automática do IAP não bater (o log "iap.audiencia_divergente" mostra o valor certo)
# IAP_AUDIENCE=/projects/NUMERO/locations/southamerica-east1/services/tatico-pd

# IA (Gemini no Vertex AI): vertex | fake (respostas fixas; padrão com NOTION_MODE=fixture) | off
# Localmente: gcloud auth application-default login (credenciais do Google Cloud, sem chave no .env)
IA_MODE=vertex
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL_TRANSCRICAO=gemini-2.5-flash
VERTEX_MODEL_REVISAO=gemini-2.5-pro
# Limite de chamadas à IA por pessoa a cada 10 minutos
IA_LIMITE_10MIN=60

PORT=8080
